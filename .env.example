# ---------- Modo ----------
# true = usa documentos fictícios (não acessa o Google Drive). Use false em produção.
DEMO_MODE=true

# ---------- Google Drive (Service Account) ----------
# ID da pasta raiz (o trecho final da URL da pasta no Drive).
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# E-mail da Service Account (campo "client_email" do JSON da chave).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada (campo "private_key" do JSON). Mantenha as quebras de linha como \n dentro das aspas.
GOOGLE_PRIVATE_KEY=""

# ---------- Catálogo / busca ----------
# Tempo (minutos) até o catálogo em memória ser relido do Drive automaticamente.
CATALOG_TTL_MINUTES=15

# ---------- Login (Auth.js) ----------
# Segredo que assina as sessões. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google (Gmail e Google Workspace): credencial "ID do cliente OAuth" no Google Cloud.
# URI de redirecionamento: https://SEU-DOMINIO/api/auth/callback/google  (local: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft (Outlook.com, Hotmail e Microsoft 365): registro de aplicativo no Microsoft Entra ID.
# URI de redirecionamento: https://SEU-DOMINIO/api/auth/callback/microsoft
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
# (Opcional) IDs de tenants Microsoft 365 confiáveis, separados por vírgula. Contas pessoais já são aceitas.
AUTH_MICROSOFT_ALLOWED_TENANTS=

# ---------- Quem pode entrar ----------
# Como qualquer pessoa tem conta Gmail/Outlook, SÓ entram os e-mails desta lista (separados por vírgula).
# Lista vazia = ninguém entra.
ALLOWED_EMAILS=
# Administradores (acesso ao /admin). Também estão autorizados a entrar.
ADMIN_EMAILS=

# ---------- Rate limit (requisições por minuto, por IP) ----------
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_FILE_PER_MIN=60
